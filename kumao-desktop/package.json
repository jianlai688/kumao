{
  "name": "kumao-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "酷猫音乐电脑桌面客户端（Electron）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm --prefix ../kumao-web run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:web": "npm --prefix ../kumao-web run build",
    "dist": "npm run build:web && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.kumao.music.desktop",
    "productName": "酷猫音乐",
    "files": ["main.js", "preload.js", "package.json", "dist/**/*"],
    "directories": { "output": "release" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
